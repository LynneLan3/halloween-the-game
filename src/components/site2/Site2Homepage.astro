---
/**
 * Website 2.0 Homepage — Astro port of Halloween_The_Game design.
 * Data from site-spec / game.portal (verified production content).
 */
import { getImage } from 'astro:assets';
import Site2Icon from './Site2Icon.astro';
import { game } from '../../config/game';
import { buildSite2HomepageModel } from '../../lib/site2-homepage';

const model = await buildSite2HomepageModel();

const heroStyle = model.heroImageUrl
	? ({
			backgroundImage: `linear-gradient(90deg,#070b0f 0%,rgba(7,11,15,.87) 27%,rgba(7,11,15,.3) 60%,rgba(7,11,15,.25)),linear-gradient(0deg,#080d11,transparent 30%), url("${model.heroImageUrl}")`,
			backgroundSize: 'cover',
			backgroundPosition: 'center 44%',
		} as Record<string, string>)
	: undefined;
const killerStyle = model.killer.imageUrl
	? ({ backgroundImage: `linear-gradient(0deg,#090e12ee,transparent 65%), url("${model.killer.imageUrl}")` } as Record<string, string>)
	: undefined;
const heroesStyle = model.heroes.imageUrl
	? ({ backgroundImage: `linear-gradient(0deg,#091115ee,transparent 65%), url("${model.heroes.imageUrl}")` } as Record<string, string>)
	: undefined;

let featuredImageUrl: string | undefined;
if (model.featured?.cover) {
	const optimized = await getImage({
		src: model.featured.cover,
		width: 1280,
		height: 720,
	});
	featuredImageUrl = optimized.src;
}
---

<div class="site-shell">
	<section class="hero">
		<div class="hero-image" style={heroStyle} />
		<div class="hero-scanlines" />
		<div class="hero-content">
			<div class="eyebrow"><span class="pulse-dot" />{model.heroBadge}</div>
			<h1>Halloween:<br /><em>The Game</em><br /><span>Guide</span></h1>
			<p class="hero-tagline">Survive Haddonfield.<br /><strong>Or become the Boogeyman.</strong></p>
			<p class="hero-copy">{game.description}</p>
			<div class="hero-buttons">
				{
					model.primaryCta && (
						<a class="arrow-button" href={model.primaryCta.href} data-astro-prefetch>
							{model.primaryCta.label}<Site2Icon name="arrow-right" size={16} />
						</a>
					)
				}
				{
					model.secondaryCta && (
						<a class="text-link" href={model.secondaryCta.href} data-astro-prefetch>
							{model.secondaryCta.label} <Site2Icon name="arrow-down-right" size={15} />
						</a>
					)
				}
			</div>
			{
				model.statusItems.length > 0 && (
					<div class="release-status" aria-label="Release timing">
						{
							model.statusItems.map((item) => (
								<div>
									<span>{item.label}</span>
									<strong>{item.value}</strong>
								</div>
							))
						}
					</div>
				)
			}
		</div>
		<div class="hero-caption">THE BOOGEYMAN IS BACK <span>SCROLL TO EXPLORE</span></div>
	</section>

	{
		model.trending.length > 0 && (
			<section class="section trending" id="guides">
				<div class="section-heading">
					<div>
						<p class="section-label"><span />Start here</p>
						<h2>What players<br /><em>need right now.</em></h2>
					</div>
					<p class="heading-note">The short version before you step into the dark.<br />Updated as the night gets closer.</p>
				</div>
				<div class="trending-grid">
					{
						model.trending.map((card, index) => (
							<a class={`trend-card ${card.accent}`} href={card.href} data-astro-prefetch>
								<div class="card-number">0{index + 1}</div>
								{card.imageUrl ? <img class="card-image" src={card.imageUrl} loading="lazy" decoding="async" alt="" /> : <div class="card-image" />}
								<div class="card-shade" />
								<div class="trend-content">
									<span class="card-label">{card.label}</span>
									<h3>{card.title}</h3>
									<p>{card.text}</p>
									<Site2Icon name="arrow-down-right" size={21} class="card-arrow" />
								</div>
							</a>
						))
					}
				</div>
			</section>
		)
	}

	{
		model.latestUpdate && (
			<section class="section latest-update-section" id="updates" aria-labelledby="latest-update-heading">
				<div class="section-heading latest-update-heading">
					<div>
						<p class="section-label"><span />Latest update</p>
						<h2 id="latest-update-heading">Patch 1.0.1 —<br /><em>what changed.</em></h2>
					</div>
					<div class="latest-update-intro">
						<p>{model.latestUpdate.title}</p>
						<a class="arrow-button" href={model.latestUpdate.href} data-astro-prefetch>
							View all updates<Site2Icon name="arrow-right" size={16} />
						</a>
					</div>
				</div>
				<ul class="latest-update-grid">
					{model.latestUpdate.items.map((item, index) => (
						<li class="latest-update-card">
							<span>0{index + 1}</span>
							<strong>{item}</strong>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		model.maps.length > 0 && (
			<section class="section map-section" id="maps">
				<div class="section-heading map-heading">
					<div>
						<p class="section-label"><span />Know your ground</p>
						<h2>Explore<br /><em>Haddonfield.</em></h2>
					</div>
					<div class="map-intro">
						<p>Every street has a story. Every window could be watching. Learn the neighborhoods before the lights go out.</p>
						<a class="arrow-button" href={model.mapsHubHref} data-astro-prefetch>
							View all maps<Site2Icon name="arrow-right" size={16} />
						</a>
					</div>
				</div>
				<div class:list={['map-grid', model.maps.length === 2 && 'map-grid--two']}>
					{
						model.maps.map((map) => (
							<a class:list={['map-card', map.large && 'map-feature']} href={map.href} data-astro-prefetch>
								{map.imageUrl ? <img class="map-image" src={map.imageUrl} loading="lazy" decoding="async" alt="" /> : <div class="map-image" />}
								<div class="map-overlay" />
								<div class="map-info">
									<span>{map.meta}</span>
									<h3>{map.title}</h3>
									<Site2Icon name="arrow-right" size={20} />
								</div>
							</a>
						))
					}
				</div>
			</section>
		)
	}

	<section class="sides-section" id="michael-myers">
		<div class="sides-intro">
			<p class="section-label"><span />Choose your side</p>
			<h2>One night.<br /><em>Two ways out.</em></h2>
			<p>Hunt the town as its most famous resident, or work together to survive him.</p>
		</div>
		<a class="side-card killer" href={model.killer.href} data-astro-prefetch>
			{model.killer.imageUrl ? <img class="side-bg" src={model.killer.imageUrl} loading="lazy" decoding="async" alt="" /> : <div class="side-bg" style={killerStyle} />}
			<div class="side-content">
				<span class="side-kicker"><Site2Icon name="skull" size={15} /> The killer</span>
				<h3>Michael<br /><em>Myers</em></h3>
				<p>Abilities · Stalk · Shape Jump · Blackouts</p>
				<span class="arrow-button">Play as Michael<Site2Icon name="arrow-right" size={16} /></span>
			</div>
		</a>
		<a class="side-card heroes" href={model.heroes.href} data-astro-prefetch>
			{model.heroes.imageUrl ? <img class="side-bg" src={model.heroes.imageUrl} loading="lazy" decoding="async" alt="" /> : <div class="side-bg" style={heroesStyle} />}
			<div class="side-content">
				<span class="side-kicker"><Site2Icon name="shield" size={15} /> The survivors</span>
				<h3>Heroes of<br /><em>Haddonfield</em></h3>
				<p>Characters · Objectives · Weapons · Police</p>
				<span class="arrow-button">Survive as a hero<Site2Icon name="arrow-right" size={16} /></span>
			</div>
		</a>
	</section>

	{
		model.questions.length > 0 && (
			<section class="section questions" id="multiplayer">
				<div class="section-heading">
					<div>
						<p class="section-label"><span />Before you queue</p>
						<h2>Popular<br /><em>questions.</em></h2>
					</div>
					<p class="heading-note">Straight answers to the things<br />everyone is asking.</p>
				</div>
				<div class="questions-grid">
					{
						model.questions.map((item, index) => (
							<a class={`question-card q${index + 1}`} href={item.href} data-astro-prefetch>
								<span>0{index + 1}</span>
								<h3>{item.question}</h3>
								<p>{item.answer}</p>
								<Site2Icon name="chevron-down" size={17} />
							</a>
						))
					}
				</div>
			</section>
		)
	}

	{
		model.categories.length > 0 && (
			<section class="section category-section" id="characters">
				<div class="section-heading">
					<div>
						<p class="section-label"><span />Go deeper</p>
						<h2>Find your<br /><em>way through.</em></h2>
					</div>
					<p class="heading-note">The field guide, organized for<br />how you actually play.</p>
				</div>
				<div class="category-grid">
					{
						model.categories.map((tile) => (
							<a class="category-tile" href={tile.href} data-astro-prefetch>
									{tile.imageUrl ? <img class="category-image" src={tile.imageUrl} loading="lazy" decoding="async" alt="" /> : <div />}
								<div class="category-overlay" />
								<span>{tile.title}</span>
								<h3>{tile.copy}</h3>
								<Site2Icon name="arrow-down-right" size={19} />
							</a>
						))
					}
				</div>
			</section>
		)
	}

	{
		model.featured && (
			<section class="section featured" id="featured">
				{featuredImageUrl ? <img class="featured-image" src={featuredImageUrl} loading="lazy" decoding="async" alt="" /> : <div class="featured-image" />}
				<div class="featured-content">
					<p class="section-label"><span />Featured guide</p>
					{model.featured.updated && <span class="updated">Updated · {model.featured.updated}</span>}
					<h2>
						{model.featured.title.includes(' — ') ? (
							<>
								{model.featured.title.split(' — ')[0]}<br /><em>{model.featured.title.split(' — ').slice(1).join(' — ')}</em>
							</>
						) : (
							model.featured.title
						)}
					</h2>
					<p>{model.featured.description}</p>
					<a class="arrow-button" href={model.featured.href} data-astro-prefetch>
						Read the guide<Site2Icon name="arrow-right" size={16} />
					</a>
				</div>
			</section>
		)
	}

	<section class="release-strip" id="about">
		<div><Site2Icon name="sparkles" size={17} /><span>The night he comes home</span></div>
		<strong>{model.releaseDate}</strong>
		<p>{model.releaseNote} · {model.platforms}</p>
	</section>
</div>

<style>
	.side-card {
		display: block;
		color: inherit;
	}
	.question-card {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.featured h2 :global(em) {
		color: #ad542e;
		font-style: normal;
	}
	.latest-update-section {
		background: #10191f;
		border-block: 1px solid rgba(231, 223, 202, 0.12);
	}
	.latest-update-heading {
		align-items: end;
	}
	.latest-update-intro {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 28px;
	}
	.latest-update-intro p {
		max-width: 360px;
		margin: 0;
		color: #c8c6ba;
		font-size: 14px;
		line-height: 1.5;
	}
	.latest-update-grid {
		max-width: 1320px;
		margin: 0 auto;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 10px;
	}
	.latest-update-card {
		min-height: 108px;
		box-sizing: border-box;
		padding: 16px 18px;
		border: 1px solid rgba(231, 223, 202, 0.14);
		background: rgba(8, 13, 17, 0.38);
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 18px;
	}
	.latest-update-card span {
		color: #dfb67a;
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 12px;
		letter-spacing: 0.12em;
	}
	.latest-update-card strong {
		font-family: 'Barlow Condensed', sans-serif;
		font-size: 20px;
		font-weight: 500;
		line-height: 1.05;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}
	@media (max-width: 900px) {
		.latest-update-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.latest-update-intro {
			display: block;
			margin-top: 23px;
		}
		.latest-update-intro .arrow-button {
			margin-top: 20px;
		}
		.latest-update-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
