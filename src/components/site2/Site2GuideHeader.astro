---
/** Website 2.0 guide page header — design system extension. */
import { loadGuideContent } from '../../lib/guide-content';
import { experienceNav } from '../../lib/experience-nav';
import { site2RouteHubHref } from '../../lib/site2-nav';
import { formatUiDate, ui } from '../../lib/ui';
import AdcashBanner from '../AdcashBanner.astro';
import ContentTrust from '../ContentTrust.astro';
import GuideStatus from '../GuideStatus.astro';
import Site2SectionNav from './Site2SectionNav.astro';

const { entry } = Astro.locals.starlightRoute;
const t = ui();
const { homeHref, guidesHref } = await experienceNav();
const content = await loadGuideContent(entry);
const data = entry.data;
const route = content.primaryRoute;
const routeLink = route ? site2RouteHubHref(route.id) : undefined;
const guideSlug = String(data.slug ?? entry.id ?? '').replace(/^\/+|\/+$/g, '');
const guideCategory = String(data.category ?? '');
const evidenceWideSlugs = new Set([
	'how-to-arrest-michael-myers',
	'michael-myers/abilities',
	'single-player',
]);
const evidenceWide = evidenceWideSlugs.has(guideSlug);
const compactBottom = guideSlug === 'michael-myers/abilities';
const progressionLayout =
	guideSlug === 'how-to-arrest-michael-myers' && content.facts.length >= 5;
---

<div
	class:list={['site2-guide', evidenceWide && 'site2-guide--evidence-wide']}
	data-guide-layout={evidenceWide ? 'evidence-wide' : undefined}
	data-guide-bottom={compactBottom ? 'compact' : undefined}
	data-guide-slug={guideSlug || undefined}
>
	<nav class="site2-guide__crumb" aria-label={t.breadcrumb}>
		<a href={homeHref} data-astro-prefetch>{t.homeNav}</a>
		<span aria-hidden="true">/</span>
		{
			route && routeLink ? (
				<>
					<a href={routeLink} data-astro-prefetch>{route.title}</a>
					<span aria-hidden="true">/</span>
				</>
			) : (
				<>
					<a href={guidesHref} data-astro-prefetch>{t.guidesNav}</a>
					<span aria-hidden="true">/</span>
				</>
			)
		}
		<span aria-current="page">{data.title}</span>
	</nav>

	<header class="site2-guide__header">
		{data.eyebrow && <p class="section-label"><span />{data.eyebrow}</p>}
		<h1>{data.title}</h1>
		{data.description && <p class="site2-guide__dek">{data.description}</p>}
		{(data.status || content.lastUpdated) && (
			<div class="site2-guide__meta">
				{data.status && <GuideStatus status={data.status} />}
				{content.lastUpdated && (
					<time datetime={content.lastUpdated.toISOString()}>
						{t.updatedOn(formatUiDate(content.lastUpdated))}
					</time>
				)}
			</div>
		)}
		{data.trust && <ContentTrust trust={data.trust} detailed={false} />}
	</header>

	{content.quickAnswer && (
		<div class="site2-guide__quick">
			<p class="section-label"><span />Quick answer</p>
			<p>{content.quickAnswer}</p>
		</div>
	)}

	{content.facts.length > 0 && (
		progressionLayout ? (
			<nav class="site2-guide__progression" aria-label="Arrest progression">
				<p class="section-label"><span />Arrest progression</p>
				<ol>
					{content.facts.map((fact) => (
						<li>
							<strong>{fact.label}</strong>
							<span>{fact.value}</span>
						</li>
					))}
				</ol>
			</nav>
		) : (
			<dl class="site2-guide__facts">
				{content.facts.map((fact) => (
					<div>
						<dt>{fact.label}</dt>
						<dd>{fact.value}</dd>
					</div>
				))}
			</dl>
		)
	)}

	<Site2SectionNav activePath={Astro.url.pathname} category={guideCategory} />

	{/* Adcash Display 300x250 — after Quick Answer / facts, before body prose */}
	<AdcashBanner />
</div>
