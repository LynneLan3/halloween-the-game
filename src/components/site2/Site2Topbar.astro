---
import Site2Icon from './Site2Icon.astro';
import {
	buildSite2NavGroups,
	site2NavActivePath,
	site2NavGroupActivePath,
} from '../../lib/site2-nav';

interface Props {
	homeHref: string;
	activePath?: string;
}

const { homeHref, activePath = '' } = Astro.props;
const navGroups = buildSite2NavGroups();
---

<header class="topbar" data-site2-topbar>
	<a class="brand" href={homeHref} data-astro-prefetch aria-label="Halloween The Game Guide home">
		<span class="brand-mark"><Site2Icon name="skull" size={19} /></span>
		<span><strong>HALLOWEEN</strong><small>The Game Guide</small></span>
	</a>
	<nav class="main-nav" data-site2-nav aria-label="Guide areas">
		{
			navGroups.map((group) => {
				const active = site2NavGroupActivePath(activePath, group);
				return group.items ? (
					<div
						class:list={['site2-nav-group', active && 'is-active']}
						data-site2-nav-group
						data-open="false"
					>
						{group.href ? (
							<a
								class="site2-nav-group__link"
								href={group.href}
								data-astro-prefetch
								aria-current={active ? 'page' : undefined}
							>
								{group.label}
							</a>
						) : (
							<button
								class="site2-nav-group__link site2-nav-group__trigger"
								type="button"
								aria-haspopup="true"
								aria-expanded="false"
								data-site2-nav-toggle
								aria-current={active ? 'location' : undefined}
							>
								{group.label}
							</button>
						)}
						<button
							class="site2-nav-group__toggle"
							type="button"
							aria-label={`Open ${group.label} menu`}
							aria-haspopup="true"
							aria-expanded="false"
							data-site2-nav-toggle
						>
							<span aria-hidden="true">⌄</span>
						</button>
						<div class="site2-nav-group__menu" data-site2-nav-menu>
							{group.items.map((item) => (
								<a
									class:list={['site2-nav-group__item', site2NavActivePath(activePath, item) && 'is-active']}
									href={item.href}
									data-astro-prefetch
									aria-current={site2NavActivePath(activePath, item) ? 'page' : undefined}
								>
									{item.label}
								</a>
							))}
						</div>
					</div>
				) : (
					<a
						class:list={['main-nav__direct', active && 'is-active']}
						href={group.href}
						data-astro-prefetch
						aria-current={active ? 'page' : undefined}
					>
						{group.label}
					</a>
				);
			})
		}
	</nav>
	<div class="nav-actions">
		<button type="button" class="search-trigger" data-site2-search-open aria-label="Search guides">
			<Site2Icon name="search" size={18} /><span>Search</span>
		</button>
		<button type="button" class="menu-trigger" data-site2-menu-trigger aria-label="Toggle navigation" aria-expanded="false">
			<Site2Icon name="menu" size={22} class="site2-icon-menu" />
			<Site2Icon name="x" size={22} class="site2-icon-close" />
		</button>
	</div>
</header>

<script is:inline>
	document.querySelectorAll('[data-site2-topbar]').forEach((topbar) => {
		if (topbar.dataset.site2Bound === 'true') return;
		topbar.dataset.site2Bound = 'true';
		const nav = topbar.querySelector('[data-site2-nav]');
		const menuTrigger = topbar.querySelector('[data-site2-menu-trigger]');
		const groups = [...topbar.querySelectorAll('[data-site2-nav-group]')];
		const closeGroup = (group) => {
			group.dataset.open = 'false';
			group.dataset.openByClick = 'false';
			group.querySelectorAll('[data-site2-nav-toggle]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
		};
		const openGroup = (group) => {
			groups.filter((candidate) => candidate !== group).forEach(closeGroup);
			group.dataset.open = 'true';
			group.querySelectorAll('[data-site2-nav-toggle]').forEach((button) => button.setAttribute('aria-expanded', 'true'));
		};
		const closeGroups = () => groups.forEach(closeGroup);
		const onScroll = () => {
			topbar.classList.toggle('is-stuck', window.scrollY > 16);
		};
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });
		if (!nav || !menuTrigger) return;
		menuTrigger.addEventListener('click', () => {
			const open = nav.classList.toggle('open');
			menuTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
			if (!open) closeGroups();
		});
		groups.forEach((group) => {
			group.addEventListener('mouseenter', () => openGroup(group));
			group.addEventListener('mouseleave', () => closeGroup(group));
			group.addEventListener('focusin', () => openGroup(group));
			group.addEventListener('focusout', (event) => {
				if (!group.contains(event.relatedTarget)) closeGroup(group);
			});
			group.querySelectorAll('[data-site2-nav-toggle]').forEach((button) => {
				button.addEventListener('click', () => {
					if (group.dataset.openByClick === 'true') closeGroup(group);
					else {
						openGroup(group);
						group.dataset.openByClick = 'true';
					}
				});
			});
		});
		nav.addEventListener('click', (event) => {
			if (event.target.closest('a')) {
				nav.classList.remove('open');
				menuTrigger.setAttribute('aria-expanded', 'false');
				closeGroups();
			}
		});
		document.addEventListener('pointerdown', (event) => {
			if (!topbar.contains(event.target)) closeGroups();
		});
			topbar.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape') return;
				const openGroup = groups.find((group) => group.dataset.open === 'true');
				if (!openGroup) return;
				openGroup.querySelector('[data-site2-nav-toggle]')?.focus();
				closeGroup(openGroup);
			});
	});
</script>

<style>
	.menu-trigger .site2-icon-close {
		display: none;
	}
	.main-nav.open ~ .nav-actions .menu-trigger .site2-icon-menu,
	.topbar:has(.main-nav.open) .menu-trigger .site2-icon-menu {
		display: none;
	}
	.topbar:has(.main-nav.open) .menu-trigger .site2-icon-close {
		display: block;
	}
</style>
