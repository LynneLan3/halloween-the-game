---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt?: string;
	class?: string;
	width?: number;
	height?: number;
}

const { image, alt = '', class: className, width = 640, height = 360 } = Astro.props;
---

<span class:list={['card-thumbnail', className]}>
	<Image src={image} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
</span>
