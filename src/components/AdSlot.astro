---
import { adSlotDataset, type AdPlacement } from '../lib/monetization';

interface Props {
	placement: AdPlacement;
}

const { placement } = Astro.props;
const dataset = adSlotDataset(placement);
---

{
	dataset && (
		<div
			class="ad-slot"
			data-ad-slot={dataset['data-ad-slot']}
			data-gw-ad-placement={placement}
			aria-label="Advertisement"
		>
			<div class="ad-slot__container" data-gw-ad-container />
			<span class="ad-slot__label" aria-hidden="true">
				ad
			</span>
		</div>
	)
}
