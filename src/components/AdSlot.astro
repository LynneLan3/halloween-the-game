---
import { adContainerId, adSlotDataset, type AdPlacement } from '../lib/monetization';

interface Props {
	placement: AdPlacement;
}

const { placement } = Astro.props;
const dataset = adSlotDataset(placement);
const containerId = adContainerId();
---

{
	dataset && (
		<div class="ad-slot" data-ad-slot={dataset['data-ad-slot']} aria-label="Advertisement">
			{containerId ? (
				<div id={containerId} class="ad-slot__container" />
			) : (
				<div class="ad-slot__container" />
			)}
			<span class="ad-slot__label" aria-hidden="true">
				ad
			</span>
		</div>
	)
}
