---
/** Formal Routes Index — Website 2.0 shell (redirects to guides when routes exist). */
import Site2GuidesIndex from '../../components/site2/Site2GuidesIndex.astro';
import Site2Shell from '../../components/site2/Site2Shell.astro';
import { game } from '../../config/game';
import { ui } from '../../lib/ui';
import { experienceNav } from '../../lib/experience-nav';

const t = ui();
const navState = await experienceNav();
const routes = game.routes ?? [];

if (routes.length === 0) return Astro.redirect(navState.guidesHref);

const { homeHref, routesHref } = navState;
---

<Site2Shell
	title={`${t.routesNav} — ${game.title}`}
	description={t.chooseWhatYoureTryingLede}
	canonical={new URL(routesHref, game.siteUrl).href}
	homeHref={homeHref}
	activePath={routesHref}
>
	<Site2GuidesIndex routes={routes} />
</Site2Shell>
