---
/** Formal Guides Index — Website 2.0 shell. */
import Site2GuidesIndex from '../components/site2/Site2GuidesIndex.astro';
import Site2Shell from '../components/site2/Site2Shell.astro';
import { game } from '../config/game';
import { ui } from '../lib/ui';
import { experienceNav } from '../lib/experience-nav';

const t = ui();
const { homeHref, guidesHref } = await experienceNav();
const routes = game.routes ?? [];
---

<Site2Shell
	title={`${t.allGuides} — ${game.title}`}
	description={game.description}
	canonical={new URL(guidesHref, game.siteUrl).href}
	homeHref={homeHref}
	activePath={guidesHref}
>
	{routes.length > 0 ? <Site2GuidesIndex routes={routes} /> : (
		<section class="site2-guides-hero">
			<div class="section-heading">
				<div>
					<p class="section-label"><span />{t.fieldGuide}</p>
					<h2>
						All<br /><em>guides.</em>
					</h2>
				</div>
				<p class="heading-note">{game.description}</p>
			</div>
		</section>
	)}
</Site2Shell>
